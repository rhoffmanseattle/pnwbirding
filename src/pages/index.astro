---
import Base from '../layouts/Base.astro';
import locations from '../data/locations.json';

const sorted = [...locations].sort((a, b) => a.order - b.order);
const pins = sorted.map((l) => ({
  slug: l.slug, name: l.name, lat: l.lat, lng: l.lng, region: l.region,
  effortLine: l.effortLine, effortTier: l.effortTier,
  order: String(l.order).padStart(2, '0'),
}));

const birds = [
  { top: 21, w: 30, glide: 38, delay: -4, opacity: 0.82, flap: 1.5 },
  { top: 27, w: 22, glide: 44, delay: -19, opacity: 0.7, flap: 1.75 },
  { top: 15, w: 17, glide: 52, delay: -34, opacity: 0.58, flap: 2.05 },
  { top: 34, w: 13, glide: 61, delay: -11, opacity: 0.46, flap: 2.4 },
  { top: 11, w: 25, glide: 47, delay: -28, opacity: 0.66, flap: 1.65 },
];
---
<Base>
  <section class="hero">
    <div class="sky"></div>
    <div class="glow"></div>
    {birds.map((b) => (
      <div class="bird" style={`top:${b.top}%; width:${b.w}px; height:${b.w * 0.4}px; animation: glide ${b.glide}s linear infinite; animation-delay:${b.delay}s; opacity:${b.opacity};`}>
        <span style={`animation-duration:${b.flap}s`}></span>
        <span style={`animation-duration:${b.flap}s`}></span>
      </div>
    ))}
    <div class="hero-content">
      <p class="mono-eyebrow eyebrow">Salish Sea · Cascade foothills · South Sound</p>
      <h1>Where should we<br />go birding?</h1>
      <div class="hero-rule"></div>
      <p class="lede">
        Thirteen proven spots around Puget Sound — from a lunch-break wetland loop
        to an eleven-mile sand spit. Seasonal birds, real distances, and what it's
        actually like on the ground.
      </p>
      <div class="actions">
        <a class="btn-primary" href="#map">Open the map</a>
        <a class="btn-ghost" href="#list">All thirteen ↓</a>
      </div>
    </div>
  </section>

  <section class="map-section" id="map">
    <div class="section-head">
      <h2>The whole territory</h2>
      <span class="mono-label head-note">Click a pin — read it, jump to it, or open it</span>
    </div>
    <div id="bigmap"></div>
    <div class="legend">
      <span><i style="background:#3fc0a8"></i>Easy</span>
      <span><i style="background:#f0c67c"></i>Moderate</span>
      <span><i style="background:#ef7f5e"></i>Strenuous</span>
    </div>
  </section>

  <section class="list-section" id="list">
    <h2>Every spot, easiest first</h2>
    <div class="rows">
      {sorted.map((l) => (
        <a class="row" href={`/spots/${l.slug}/`} id={`row-${l.slug}`}>
          <span class="idx">{String(l.order).padStart(2, '0')}</span>
          <span class="namecell">
            <span class="locname">{l.name}</span>
            <span class="mono-label region">{l.region}</span>
          </span>
          <span class="habitat">{l.habitat}</span>
          <span class="effort">{l.effortLine}</span>
          <span class="arrow">→</span>
        </a>
      ))}
      <div class="row-cap"></div>
    </div>
  </section>

  <section class="photo-strip">
    <div class="cell"></div><div class="cell"></div><div class="cell"></div><div class="cell"></div>
  </section>

  <script type="application/json" id="pins-data" set:html={JSON.stringify(pins)} />

  <style>
    .hero { position: relative; min-height: 100vh; overflow: hidden; display: flex; align-items: flex-end; }
    .sky {
      position: absolute; inset: -8%;
      background: linear-gradient(178deg,
        oklch(0.19 0.055 262) 0%,
        oklch(0.29 0.075 248) 32%,
        oklch(0.46 0.075 232) 58%,
        oklch(0.66 0.062 210) 78%,
        oklch(0.84 0.055 78) 100%);
      animation: skyDrift 46s ease-in-out infinite alternate;
    }
    .glow { position: absolute; inset: 0; background: radial-gradient(90% 62% at 68% 100%, rgba(255,232,196,.32), rgba(255,232,196,0) 62%); }
    .hero-content { position: relative; max-width: 780px; padding: 124px 0 96px 40px; }
    .eyebrow { color: rgba(255,255,255,.72); margin: 0 0 18px; }
    h1 {
      font-family: var(--serif); font-weight: 400;
      font-size: clamp(52px, 7.2vw, 112px);
      line-height: .93; letter-spacing: -.015em; text-wrap: balance;
      margin: 0;
    }
    .hero-rule { width: 96px; height: 1px; background: rgba(255,255,255,.5); margin: 26px 0; }
    .lede { font-size: 19px; line-height: 1.58; max-width: 44ch; text-wrap: pretty; color: var(--ink-muted); margin: 0 0 34px; }
    .actions { display: flex; gap: 14px; }
    .btn-primary, .btn-ghost {
      font-family: var(--mono); font-size: 11px; letter-spacing: .18em; text-transform: uppercase;
      text-decoration: none; padding: 15px 26px; transition: all .18s;
    }
    .btn-primary { border: 1px solid rgba(255,255,255,.45); color: #fff; }
    .btn-primary:hover { background: #fff; color: var(--bg); }
    .btn-ghost { color: rgba(255,255,255,.72); padding-left: 8px; }
    .btn-ghost:hover { color: #fff; }

    .map-section { padding: 110px 40px 90px; border-top: 1px solid var(--rule); }
    .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 30px; }
    h2 { font-family: var(--serif); font-weight: 400; font-size: clamp(34px, 4vw, 56px); letter-spacing: -.01em; margin: 0; }
    .head-note { color: var(--ink-faint); }
    #bigmap { height: 62vh; min-height: 460px; border: 1px solid var(--border); }
    .legend { display: flex; gap: 26px; padding-top: 16px; font-family: var(--mono); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-faint); }
    .legend i { display: inline-block; width: 9px; height: 9px; border-radius: 50%; box-shadow: 0 0 0 1.5px rgba(255,255,255,.85); margin-right: 9px; }

    .list-section { padding: 40px 40px 130px; }
    .list-section h2 { margin-bottom: 30px; }
    .row {
      display: grid;
      grid-template-columns: 62px minmax(0,2.1fr) minmax(0,1.5fr) 190px 46px;
      gap: 20px; align-items: baseline;
      padding: 26px 8px;
      border-top: 1px solid var(--rule);
      text-decoration: none;
      transition: padding-left .18s, background .18s;
    }
    .row:hover { background: linear-gradient(90deg, rgba(232,238,246,.07), rgba(232,238,246,0)); padding-left: 20px; }
    .row-cap { border-top: 1px solid var(--rule); }
    .idx { font-family: var(--mono); font-size: 13px; color: var(--ink-fainter); }
    .namecell { display: flex; flex-direction: column; gap: 4px; }
    .locname { font-family: var(--serif); font-size: clamp(24px, 2.5vw, 36px); line-height: 1.08; }
    .region { color: var(--ink-faint); }
    .habitat { color: rgba(232,238,246,.68); font-size: 14.5px; }
    .effort { font-family: var(--mono); font-size: 12.5px; letter-spacing: .04em; color: var(--accent); }
    .arrow { font-family: var(--mono); color: var(--ink-fainter); text-align: right; }

    .photo-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; }
    .photo-strip .cell { aspect-ratio: 4/3; min-height: 200px; background: var(--surface); }

    @media (max-width: 1000px) {
      .row { grid-template-columns: 46px minmax(0,1.6fr) 170px 30px; }
      .habitat { display: none; }
    }
    @media (max-width: 760px) {
      .hero-content { padding: 124px 20px 72px; }
      .map-section, .list-section { padding-left: 20px; padding-right: 20px; }
      .row { grid-template-columns: 38px 1fr; grid-template-rows: auto auto; row-gap: 6px; }
      .effort { grid-column: 2; }
      .arrow { display: none; }
      .photo-strip { grid-template-columns: repeat(2, 1fr); }
    }
  </style>

  <script>
    import L from 'leaflet';
    import 'leaflet/dist/leaflet.css';

    const TIER_COLORS: Record<string, string> = { Easy: '#3fc0a8', Moderate: '#f0c67c', Strenuous: '#ef7f5e' };
    const pins = JSON.parse(document.getElementById('pins-data')!.textContent!);

    const map = L.map('bigmap', { scrollWheelZoom: false }).setView([47.75, -122.45], 8);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; OpenStreetMap contributors',
    }).addTo(map);

    for (const p of pins) {
      const marker = L.circleMarker([p.lat, p.lng], {
        radius: 7, color: '#ffffff', weight: 2, fillOpacity: 1,
        fillColor: TIER_COLORS[p.effortTier] ?? '#f0c67c',
      }).addTo(map);

      const el = document.createElement('div');
      el.innerHTML = `
        <div style="font-family:var(--mono); font-size:10px; letter-spacing:.2em; text-transform:uppercase; color:#7f8fa6; margin-bottom:6px;">${p.order} · ${p.region}</div>
        <div style="font-family:var(--serif); font-size:21px; line-height:1.1; margin-bottom:6px;">${p.name}</div>
        <div style="font-family:var(--mono); font-size:11.5px; color:${TIER_COLORS[p.effortTier]}; margin-bottom:12px;">${p.effortLine}</div>
        <div style="display:flex; gap:16px;">
          <a href="/spots/${p.slug}/" style="font-family:var(--mono); font-size:10.5px; letter-spacing:.14em; text-transform:uppercase; color:#e8eef6;">Full write-up →</a>
          <a href="#" data-jump="${p.slug}" style="font-family:var(--mono); font-size:10.5px; letter-spacing:.14em; text-transform:uppercase; color:#7f8fa6;">Jump to list ↓</a>
        </div>`;
      el.querySelector('[data-jump]')!.addEventListener('click', (e) => {
        e.preventDefault();
        map.closePopup();
        const row = document.getElementById(`row-${p.slug}`);
        if (!row) return;
        const top = row.getBoundingClientRect().top + window.pageYOffset - 130;
        window.scrollTo({ top, behavior: 'smooth' });
        row.style.animation = 'none';
        void row.offsetWidth;
        row.style.animation = 'rowFlash 1.6s ease-out';
      });

      // A pin click opens only its popup; no page scroll.
      marker.bindPopup(el, { closeButton: true, offset: [0, -6], autoPan: true, autoPanPadding: [24, 90] });
    }
  </script>
</Base>
