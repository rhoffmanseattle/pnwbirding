---
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · Puget Sound Birding` : 'Puget Sound Birding'}</title>
    <meta name="description" content={description ?? 'Where to go bird watching around Puget Sound: maps, seasonal birds, and honest effort ratings.'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:global>
      :root {
        --ink: #1f2a24;
        --ink-soft: #51625a;
        --paper: #f7f6f1;
        --card: #ffffff;
        --accent: #2f6b4f;
        --accent-soft: #e3eee8;
        --line: #dcded6;
        --amber: #b98134;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background: var(--paper);
        color: var(--ink);
        line-height: 1.55;
      }
      a { color: var(--accent); }
      .wrap { max-width: 980px; margin: 0 auto; padding: 0 1.25rem; }
      header.site {
        background: var(--accent);
        color: #fff;
        padding: 1rem 0;
      }
      header.site .wrap { display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; }
      header.site a.brand {
        color: #fff; text-decoration: none; font-weight: 700; font-size: 1.25rem; letter-spacing: 0.01em;
      }
      header.site span.tag { color: #cfe3d8; font-size: 0.9rem; }
      main { padding: 1.5rem 0 3rem; }
      footer.site {
        border-top: 1px solid var(--line);
        padding: 1.5rem 0 2.5rem;
        color: var(--ink-soft);
        font-size: 0.85rem;
      }
      footer.site p { margin: 0.35rem 0; }
      h1 { font-size: 1.7rem; margin: 0.5rem 0 0.25rem; }
      h2 { font-size: 1.2rem; margin: 1.75rem 0 0.5rem; }
      .muted { color: var(--ink-soft); }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">Puget Sound Birding</a>
        <span class="tag">where to go, what you'll see, how far you'll walk</span>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site">
      <div class="wrap">
        <p>
          Live sighting data from <a href="https://ebird.org">eBird</a>, Cornell Lab of Ornithology.
          Location research draws on <a href="https://www.wta.org/go-outside/seasonal-hikes/year-round-destinations/bird-watching-hikes-in-washington">Washington Trails Association</a>,
          <a href="https://www.eastsideaudubon.org/">Eastside Audubon</a>,
          <a href="https://birdsconnectsea.org/">Birds Connect Seattle</a>,
          <a href="https://wos.org/birding-resources/maps/">Washington Ornithological Society</a>,
          and <a href="https://www.birdful.org/where-can-i-go-birdwatching-in-seattle/">Birdful</a>.
          Each location page lists its specific sources.
        </p>
        <p>Map tiles © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors.</p>
      </div>
    </footer>
  </body>
</html>
